msgstr "%d میلی‌ثانیه"

#. translators: %d: days until the TLS certificate expires
#: includes/class-downtime-widget.php:146
#, php-format
msgid "certificate expires in %d days"
msgstr "گواهی تا %d روز دیگر منقضی می‌شود"

