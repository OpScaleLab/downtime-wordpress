#: includes/class-downtime-widget.php:151
#, php-format
msgid "%1$s%% up over the last %2$d check"
msgid_plural "%1$s%% up over the last %2$d checks"
msgstr[0] "%1$s%% در دسترس در %2$d بررسی اخیر"
msgstr[1] "%1$s%% در دسترس در %2$d بررسی اخیر"

#: includes/class-downtime-widget.php:162
msgid "Recent incidents"
msgstr "رخدادهای اخیر"

#: includes/class-downtime-widget.php:165
