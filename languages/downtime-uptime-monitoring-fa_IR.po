msgstr "‏/wp-json/ پاسخ می‌دهد. ویرایشگر بلوک، بسیاری از افزونه‌ها و اپ‌های موبایل به آن وابسته‌اند."

#. translators: %s: site name
#: includes/class-downtime-checks.php:103
#, php-format
msgid "%s: REST API"
msgstr "%s: REST API"

#: includes/class-downtime-checks.php:112
