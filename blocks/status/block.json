{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "downtime/status",
	"title": "DownTime Status",
	"category": "widgets",
	"icon": "heart",
	"description": "Show your DownTime status page, status badge or uptime badge.",
	"keywords": [ "uptime", "status", "monitoring" ],
	"textdomain": "downtime",
	"attributes": {
		"mode": { "type": "string", "default": "page", "enum": [ "page", "badge", "uptime" ] },
		"slug": { "type": "string", "default": "" },
		"height": { "type": "number", "default": 600 }
	},
	"supports": { "html": false, "align": [ "wide", "full" ] },
	"editorScript": "file:./index.js"
}
