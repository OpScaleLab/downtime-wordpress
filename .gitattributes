# Left out of `git archive` (and therefore of the release ZIP and GitHub's
# source archives): development-only files that don't belong in an
# installed plugin.
/.gitattributes  export-ignore
/.gitignore      export-ignore
/.github         export-ignore
/bin             export-ignore
/docker-compose.yml export-ignore
/README.md       export-ignore
# Translations reach users through translate.wordpress.org language packs;
# the Persian source stays here for importing there, not in the ZIP.
/languages/*.po   export-ignore
/languages/*.mo   export-ignore
/languages/*.json export-ignore
